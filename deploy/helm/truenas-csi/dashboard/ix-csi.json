      "id": 12,
      "targets": [
        {
          "expr": "sum by (method_name, container, grpc_status_code) (rate(csi_sidecar_operations_seconds_count{driver_name=\"csi.truenas.io\",grpc_status_code!=\"OK\"}[$__rate_interval]))",
