{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Use a one-cluster datasource with standard namespace/pod labels. Workload namespaces and StorageClasses are independent of driver selection; choose them explicitly.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 9,
      "panels": [],
      "title": "CSI Driver",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Reported connection status of selected targets; missing or unscraped pods are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "avg(ix_csi_truenas_connection_status{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\"})",
          "legendFormat": "connected",
          "refId": "A"
        }
      ],
      "title": "TrueNAS Connection Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (result, container) (rate(ix_csi_truenas_reconnects_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\"}[$__rate_interval]))",
          "legendFormat": "{{container}} / {{result}}",
          "refId": "A"
        }
      ],
      "title": "TrueNAS Reconnects",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "KSM Bound PV count, deduplicated and filtered by PVC namespace and StorageClass. No matches yield no series.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 8,
      "targets": [
        {
          "expr": "count by (storageclass) (max by (persistentvolume, storageclass) (kube_persistentvolume_info{job=~\"$ksm_job\",storageclass=~\"$storageclass\"}) * on (persistentvolume) group_left () (max by (persistentvolume) (kube_persistentvolume_status_phase{job=~\"$ksm_job\",phase=\"Bound\"}) == 1) and on (persistentvolume) label_replace(max by (volumename) (kube_persistentvolumeclaim_info{job=~\"$ksm_job\",namespace=~\"$workload_namespace\",storageclass=~\"$storageclass\",volumename!=\"\"}), \"persistentvolume\", \"$1\", \"volumename\", \"(.+)\"))",
          "legendFormat": "{{storageclass}}",
          "refId": "A"
        }
      ],
      "title": "Bound PVs by StorageClass",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "KSM Bound PV capacity, deduplicated and filtered by PVC namespace and StorageClass; not backend free space or process-local inventory.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (storageclass) (max by (persistentvolume) (kube_persistentvolume_capacity_bytes{job=~\"$ksm_job\"}) * on (persistentvolume) group_left (storageclass) max by (persistentvolume, storageclass) (kube_persistentvolume_info{job=~\"$ksm_job\",storageclass=~\"$storageclass\"}) * on (persistentvolume) group_left () (max by (persistentvolume) (kube_persistentvolume_status_phase{job=~\"$ksm_job\",phase=\"Bound\"}) == 1) and on (persistentvolume) label_replace(max by (volumename) (kube_persistentvolumeclaim_info{job=~\"$ksm_job\",namespace=~\"$workload_namespace\",storageclass=~\"$storageclass\",volumename!=\"\"}), \"persistentvolume\", \"$1\", \"volumename\", \"(.+)\"))",
          "legendFormat": "{{storageclass}}",
          "refId": "A"
        }
      ],
      "title": "Bound PV Capacity by StorageClass",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (operation, container) (rate(ix_csi_operations_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\"}[$__rate_interval]))",
          "legendFormat": "{{container}} / {{operation}}",
          "refId": "A"
        }
      ],
      "title": "CSI RPC Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 2,
      "description": "Quantiles may be misleading during rollouts mixing old and extended histogram buckets.",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (operation, container, le) (rate(ix_csi_operations_duration_seconds_bucket{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\"}[$__rate_interval])))",
          "legendFormat": "{{container}} / {{operation}} p95",
          "refId": "A"
        }
      ],
      "title": "CSI RPC Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (operation, container, code) (rate(ix_csi_operations_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",status=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{container}} / {{operation}} {{code}}",
          "refId": "A"
        }
      ],
      "title": "CSI RPC Errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(ix_csi_truenas_requests_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",status=\"error\"}[$__rate_interval])) / sum(rate(ix_csi_truenas_requests_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\"}[$__rate_interval]))",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "title": "TrueNAS API Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "id": 19,
      "targets": [
        {
          "expr": "100 * sum by (container) (rate(container_cpu_usage_seconds_total{job=~\"$kubelet_job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",container=~\"csi-(controller|node)\"}[$__rate_interval]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "title": "Driver CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "id": 20,
      "targets": [
        {
          "expr": "sum by (container) (container_memory_working_set_bytes{job=~\"$kubelet_job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",container=~\"csi-(controller|node)\"})",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "title": "Driver Memory Working Set",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "id": 13,
      "panels": [],
      "title": "External Provisioner Metrics",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 42
      },
      "id": 14,
      "targets": [
        {
          "expr": "sum by (class, source) (rate(controller_persistentvolumeclaim_provision_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",class=~\"$storageclass\"}[$__rate_interval]))",
          "legendFormat": "provision {{class}} {{source}}",
          "refId": "A"
        },
        {
          "expr": "sum by (class, source) (rate(controller_persistentvolumeclaim_provision_failed_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",class=~\"$storageclass\"}[$__rate_interval]))",
          "legendFormat": "provision failed {{class}} {{source}}",
          "refId": "B"
        }
      ],
      "title": "Provision Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 42
      },
      "id": 16,
      "targets": [
        {
          "expr": "sum by (class) (rate(controller_persistentvolume_delete_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",class=~\"$storageclass\"}[$__rate_interval]))",
          "legendFormat": "delete {{class}}",
          "refId": "A"
        },
        {
          "expr": "sum by (class) (rate(controller_persistentvolume_delete_failed_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",class=~\"$storageclass\"}[$__rate_interval]))",
          "legendFormat": "delete failed {{class}}",
          "refId": "B"
        }
      ],
      "title": "Delete Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 42
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (method_name, container) (rate(csi_sidecar_operations_seconds_count{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",driver_name=\"csi.ix-csi.io\"}[$__rate_interval]))",
          "legendFormat": "{{container}} / {{method_name}}",
          "refId": "A"
        }
      ],
      "title": "CSI Sidecar Operation Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 50
      },
      "id": 15,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (class, source, le) (rate(controller_persistentvolumeclaim_provision_duration_seconds_bucket{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",class=~\"$storageclass\"}[$__rate_interval])))",
          "legendFormat": "{{class}} {{source}} p95",
          "refId": "A"
        }
      ],
      "title": "Provision Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 50
      },
      "id": 17,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (class, le) (rate(controller_persistentvolume_delete_duration_seconds_bucket{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",class=~\"$storageclass\"}[$__rate_interval])))",
          "legendFormat": "{{class}} p95",
          "refId": "A"
        }
      ],
      "title": "Delete Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 50
      },
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (method_name, container, le) (rate(csi_sidecar_operations_seconds_bucket{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",driver_name=\"csi.ix-csi.io\"}[$__rate_interval])))",
          "legendFormat": "{{container}} / {{method_name}} p95",
          "refId": "A"
        }
      ],
      "title": "CSI Sidecar Operation Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "id": 12,
      "targets": [
        {
          "expr": "sum by (method_name, container, grpc_status_code) (rate(csi_sidecar_operations_seconds_count{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",driver_name=\"csi.ix-csi.io\",grpc_status_code!=\"OK\"}[$__rate_interval]))",
          "legendFormat": "{{container}} / {{method_name}} {{grpc_status_code}}",
          "refId": "A"
        }
      ],
      "title": "CSI Sidecar Operation Errors",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "id": 23,
      "panels": [],
      "title": "Driver API and Protocol Metrics",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Per-attempt latency, excluding reconnect/semaphore waits, login and HTTP preflight. Mixed histogram buckets during rollout can distort quantiles.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 67
      },
      "id": 21,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (method, le) (rate(ix_csi_truenas_requests_duration_seconds_bucket{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\"}[$__rate_interval])))",
          "legendFormat": "{{method}} p95",
          "refId": "A"
        }
      ],
      "title": "TrueNAS API Attempt Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Create/delete/expand/snapshot activity, not inventory. Requires ix_csi_volume_operations_total; workload namespace and StorageClass filters do not apply.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 67
      },
      "id": 22,
      "targets": [
        {
          "expr": "sum by (protocol, operation, status) (rate(ix_csi_volume_operations_total{job=~\"$job\",namespace=~\"$driver_namespace\",pod=~\"$driver_pod\"}[$__rate_interval]))",
          "legendFormat": "{{protocol}} / {{operation}} / {{status}}",
          "refId": "A"
        }
      ],
      "title": "Volume Operations by Protocol",
      "type": "timeseries"
    }
  ],
  "refresh": "",
  "schemaVersion": 42,
  "tags": ["ix-csi", "truenas", "csi"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "Shared driver/sidecar scrape job.",
        "label": "Driver / sidecar job",
        "name": "job",
        "options": [],
        "query": "label_values(ix_csi_truenas_connection_status, job)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "Driver pod namespaces, not PVC namespaces.",
        "includeAll": true,
        "label": "Driver namespace",
        "multi": true,
        "name": "driver_namespace",
        "options": [],
        "query": "label_values(ix_csi_truenas_connection_status{job=~\"$job\"}, namespace)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "Select one release's pods to isolate it. All includes only scraped driver pods; refresh explicit selections after rollouts.",
        "includeAll": true,
        "label": "Driver pods",
        "multi": true,
        "name": "driver_pod",
        "options": [],
        "query": "label_values(ix_csi_truenas_connection_status{job=~\"$job\",namespace=~\"$driver_namespace\"}, pod)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "label": "kube-state-metrics job",
        "name": "ksm_job",
        "options": [],
        "query": "label_values(kube_storageclass_info, job)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "PVC resource namespace, not KSM scrape namespace. Filters only Bound PV inventory.",
        "includeAll": true,
        "label": "Workload namespace (PVC)",
        "multi": true,
        "name": "workload_namespace",
        "options": [],
        "query": "label_values(kube_persistentvolumeclaim_info{job=~\"$ksm_job\"}, namespace)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "Filters PV inventory and provisioner metrics with a class label. All includes other provisioners' classes.",
        "includeAll": true,
        "label": "StorageClass",
        "multi": true,
        "name": "storageclass",
        "options": [],
        "query": "label_values(kube_storageclass_info{job=~\"$ksm_job\"}, storageclass)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "cAdvisor CPU/memory uses driver pod resource namespaces, not scrape or PVC namespaces.",
        "label": "Kubelet / cAdvisor job",
        "name": "kubelet_job",
        "options": [],
        "query": "label_values(container_cpu_usage_seconds_total{namespace=~\"$driver_namespace\",pod=~\"$driver_pod\",container=~\"csi-(controller|node)\"}, job)",
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
